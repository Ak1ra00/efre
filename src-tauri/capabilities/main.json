{
  "identifier": "main",
  "description": "Least privilege for efre's only window: exactly efre's own IPC commands (docs/IPC.md) and listening to its events (key-step, locked). No plugin permissions.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-status",
    "allow-setup-start",
    "allow-setup-enroll-key",
    "allow-setup-finish",
    "allow-setup-cancel",
    "allow-unlock",
    "allow-lock",
    "allow-cancel-prompt",
    "allow-activity",
    "allow-list-items",
    "allow-get-item",
    "allow-create-item",
    "allow-update-item",
    "allow-set-favorite",
    "allow-trash-item",
    "allow-restore-item",
    "allow-delete-item",
    "allow-empty-trash",
    "allow-reveal-field",
    "allow-copy-field",
    "allow-copy-role",
    "allow-generate-password",
    "allow-generate-passphrase",
    "allow-copy-generated",
    "allow-get-settings",
    "allow-set-settings",
    "allow-list-keys",
    "allow-add-key",
    "allow-rename-key",
    "allow-remove-key",
    "allow-open-vault-folder",
    "allow-security-info"
  ]
}
